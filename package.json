{
  "name": "ai-education-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run test:data",
    "test:data": "node --test tests/cell/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run test:data && npm run typecheck && npm run lint && npm run build",
    "verify:full": "npm run verify && npm run test:e2e",
    "repro:check": "node scripts/cell-repro-hashes.mjs --check",
    "render:cell-previews": "node scripts/render-cell-front-previews.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.12",
    "@types/mdx": "^2.0.14",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.185.1",
    "ajv": "8.20.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
